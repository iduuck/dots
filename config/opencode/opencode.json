{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "AGENTS.local.md",
    "CLAUDE.md",
    "CLAUDE.local.md",
    ".cursor/rules/*.md",
    ".cursor/rules/*.mdc",
    ".cursor/rules/*.mdx"
  ],
  "default_agent": "plan",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh"
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high"
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "lsp": false,
  "experimental": {
    "disable_paste_summary": true
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
  ],
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "agentation": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "agentation-mcp",
        "server"
      ]
    },
    "linear": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.linear.app/mcp"
    },
    "figma": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:3845/mcp"
    },
    "playwriter": {
      "type": "local",
      "command": [
        "npx",
        "playwriter@latest"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
  }
}
