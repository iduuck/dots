theme = Catppuccin Frappe

font-size = 13

font-family = MonoLisa Regular Nerd Font Complete Mono
font-family-bold = MonoLisa Bold Nerd Font Complete Mono
font-family-italic = MonoLisa Regular Italic Nerd Font Complete Mono
font-family-bold-italic = MonoLisa Bold Italic Nerd Font Complete Mono

title = ""
shell-integration = zsh
shell-integration-features = no-title

adjust-cell-height = 10%

macos-titlebar-style=tabs
macos-titlebar-proxy-icon=hidden

keybind = ctrl+b>c=new_tab
keybind = ctrl+b>q=close_surface
keybind = ctrl+b>1=goto_tab:1
keybind = ctrl+b>2=goto_tab:2
keybind = ctrl+b>3=goto_tab:3
keybind = ctrl+b>4=goto_tab:4
keybind = ctrl+b>5=goto_tab:5
keybind = ctrl+b>6=goto_tab:6
keybind = shift+enter=text:\n
